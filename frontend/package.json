{
  "name": "agent-workbench",
  "private": true,
  "version": "0.1.0",
  "productName": "Agent Workbench",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "wait-on tcp:127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:backend": "cd ../backend && uv run --group packaging pyinstaller --clean --noconfirm agent-workbench-backend.spec",
    "lint": "oxlint",
    "test:eval-guide": "node --experimental-strip-types --test tests/evalGuideFlow.test.mjs",
    "test:demo": "node --experimental-strip-types --test tests/demoEvals.test.mjs tests/evalReview.test.mjs tests/recordedEvals.test.mjs",
    "test:git": "node --experimental-strip-types --test tests/gitReview.test.mjs",
    "test:chat": "node --experimental-strip-types --test tests/chatSync.test.mjs tests/rpcClient.test.mjs",
    "test:catalog": "node --experimental-strip-types --test tests/catalogPagination.test.mjs",
    "test:contract": "tsc -p tsconfig.contract.json",
    "test:electron": "node --test tests/electron*.test.cjs",
    "test:electron:smoke": "electron tools/electron-security-smoke.cjs",
    "test:package:catalog": "node tools/packaged-catalog-smoke.mjs",
    "package": "npm run build && npm run build:backend && electron-forge package",
    "make": "npm run build && npm run build:backend && electron-forge make",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "main": "electron/main.cjs",
  "config": {
    "forge": "./forge.config.cjs"
  }
}
